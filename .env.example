# Copia este archivo como .env.local para desarrollo, o define las variables
# en Vercel (Project Settings > Environment Variables). Todas son opcionales:
# si faltan, src/config.js usa valores por defecto (la URL de la API es un placeholder
# y lo avisa en consola).

# Base de la API (incluye /api/v1). El formulario hace POST a ${VITE_API_BASE_URL}/demo-requests
VITE_API_BASE_URL=http://localhost:5192/api/v1

# Enlace público del evento de Cal.com para agendar la demo (por defecto: evento real "Demo SmartStay")
VITE_CALCOM_URL=https://cal.com/piero-sulca-sanchez-rhh1nt/demo-smartstay

# Contacto comercial. Teléfono y WhatsApp se muestran como texto plano (sin enlaces
# tel: ni wa.me) con formato +51 9XX XXX XXX; acepta el número con o sin +51 y separadores.
# El correo sí es un enlace mailto:. Por defecto son valores ficticios.
VITE_SALES_EMAIL=ventas@smartstay.pe
VITE_SALES_PHONE=+51 947 318 265
VITE_WHATSAPP_NUMBER=+51 962 574 813

# App web (login / registro)
VITE_WEB_APP_URL=https://smartstay-movildev-web.vercel.app

# Opcionales: si quedan vacíos se muestra el estado "Próximamente" o un espacio reservado
VITE_APP_DOWNLOAD_URL=
VITE_TESTIMONIAL_VIDEO_URL=
VITE_PRODUCT_VIDEO_URL=
